{
  "name": "angular-extensions",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve dashboard --open",
    "build": "ng build angular-extensions --configuration production",
    "pack": "npm pack ./dist/angular-extensions",
    "publish": "npm publish ./dist/angular-extensions",
    "analyze": "ng build dashboard --configuration production --source-map=true --named-chunks=true && source-map-explorer dist/dashboard/**/*.js",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.8",
    "@angular/common": "19.2.8",
    "@angular/compiler": "19.2.8",
    "@angular/core": "19.2.8",
    "@angular/forms": "19.2.8",
    "@angular/platform-browser": "19.2.8",
    "@angular/platform-browser-dynamic": "19.2.8",
    "@angular/router": "19.2.8",
    "@angular/cdk": "19.2.11",
    "@angular/material": "19.2.11",
    "angular2-ladda": "5.0.0",
    "bootstrap": "4.6.1",
    "date-fns": "4.1.0",
    "ladda": "2.0.3",
    "lodash-es": "4.17.21",
    "@sleiss/ngx-awesome-uploader": "19.0.2",
    "ngx-mask": "19.0.6",
    "ngx-mat-select-search": "8.0.0",
    "rxjs": "7.8.2",
    "zone.js": "0.15.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "19.3.0",
    "@angular-eslint/eslint-plugin": "19.3.0",
    "@angular-eslint/eslint-plugin-template": "19.3.0",
    "@angular-eslint/schematics": "19.3.0",
    "@angular-eslint/template-parser": "19.3.0",
    "@angular/build": "19.2.9",
    "@angular/cli": "19.2.9",
    "@angular/compiler-cli": "19.2.8",
    "@types/lodash-es": "4.17.12",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "@typescript-eslint/types": "8.31.0",
    "@typescript-eslint/utils": "8.31.0",
    "eslint": "9.25.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "50.6.10",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "ng-packagr": "19.2.2",
